{
  "name": "upsed",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandakan/UPSED.git"
  },
  "defaultBranch": "master",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "devtools": "react-devtools",
    "lint-ui": "tsc --noEmit",
    "app:preview": "start ./src-tauri/target/release/upsed.exe",
    "app:build": "tauri build",
    "sync:logo": "node scripts/generate-logo.js",
    "logs": "node scripts/open-logs.js",
    "logs:open": "node scripts/open-logs.js",
    "bridge:build": "node scripts/pio.js run",
    "bridge:compile": "node scripts/pio.js run",
    "bridge:upload": "node scripts/pio.js run --target upload",
    "bridge:ota": "node scripts/pio.js run -e esp32-s3-ota --target upload",
    "bridge:clean": "node scripts/pio.js run --target clean",
    "bridge:monitor": "node scripts/pio.js device monitor",
    "pio:build": "node scripts/pio.js run",
    "pio:compile": "node scripts/pio.js run",
    "pio:upload": "node scripts/pio.js run --target upload",
    "pio:ota": "node scripts/pio.js run -e esp32-s3-ota --target upload",
    "pio:clean": "node scripts/pio.js run --target clean",
    "pio:monitor": "node scripts/pio.js device monitor"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.43.0",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "oxc-transform-react": "^0.156.0",
    "react-devtools": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  }
}
