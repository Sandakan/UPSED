# ==============================================================================
# UPSED Configuration & Secrets
# ==============================================================================

# Shared authentication secret for Over-The-Air (OTA) firmware flashing.
# Must match between the UPSED Desktop App and the ESP32-S3 firmware build.
# Copy this file to '.env' and change the secret below to your own secure passphrase:
UPSED_OTA_SECRET=upsed-ota-secret-change-me
