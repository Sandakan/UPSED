{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPSED",
  "version": "0.1.0",
  "identifier": "com.adsandakannipunajith.upsed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UPSED",
        "width": 1366,
        "height": 768,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
