{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPSED",
  "version": "0.2.0",
  "identifier": "com.adsandakannipunajith.upsed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UPSED",
        "width": 1366,
        "height": 768,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Rjc4RjdBRTAzQ0Q5MzEKUldReDJUemdlby8zSjFPd1hCcjM4MzhhV2NlRTh2dVV4aHFqdUFaWVVpTE5zb1FJcnhBTGtPM1cK",
      "endpoints": [
        "https://github.com/Sandakan/UPSED/releases/latest/download/latest.json"
      ]
    }
  }
}
